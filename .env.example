# ============================================================================
# Joshi's Academy — Production & Development Environment Variables
# Pure Supabase Architecture (No local MySQL required)
# ============================================================================

# Supabase Project Configuration
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-public-key>
SUPABASE_PUBLISHABLE_KEY=<your-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# CMS Administrator Credentials
CMS_ADMIN_EMAIL=admin@joshisacademy.com
CMS_ADMIN_PASSWORD=Admin@123

# Google Places & Reviews (Optional for live sync)
GOOGLE_MAPS_API_KEY=your_google_places_api_key_here
GOOGLE_PLACE_ID=your_google_place_id_here
